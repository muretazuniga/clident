{
  "name": "clident-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc -p ../tsconfig.server.json",
    "build": "node build.mjs",
    "dev": "tsx ../scripts/dev-api.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "tsx check-database.ts",
    "check:readiness": "tsx check-readiness.ts",
    "db:migrate": "tsx ../scripts/migrate.ts",
    "bootstrap": "tsx ../scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "~5.8.0"
  }
}
